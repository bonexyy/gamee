struct ComboSystem {
    int comboCount, maxComboReached; float comboTimer, comboMultiplier;
    void Reset() { comboCount = 0; comboTimer = 0; comboMultiplier = 1.0f; maxComboReached = 0; }
    void AddKill() { comboCount++; comboTimer = 3.0f; comboMultiplier = std::min(5.0f, 1.0f + comboCount * 0.1f); if (comboCount > maxComboReached) maxComboReached = comboCount; }
    void Update() { if (comboTimer > 0) { comboTimer -= GetFrameTime(); if (comboTimer <= 0) { comboCount = 0; comboMultiplier = 1.0f; } } }
};

