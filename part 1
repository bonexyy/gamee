struct Button {
    Rectangle bounds; std::string text; Color baseColor, hoverColor, textColor;
    bool isHovered; float hoverAnimation;
    bool IsClicked() { Vector2 m = GetMousePosition(); isHovered = CheckCollisionPointRec(m, bounds); return isHovered && IsMouseButtonPressed(MOUSE_LEFT_BUTTON); }
    void Update() { Vector2 m = GetMousePosition(); isHovered = CheckCollisionPointRec(m, bounds);
        if (isHovered) { hoverAnimation += GetFrameTime() * 5.0f; if (hoverAnimation > 1.0f) hoverAnimation = 1.0f; }
        else { hoverAnimation -= GetFrameTime() * 5.0f; if (hoverAnimation < 0.0f) hoverAnimation = 0.0f; } }
    void Draw() {
        Color c = baseColor;
        if (hoverAnimation > 0) { c.r = (unsigned char)(baseColor.r + (hoverColor.r - baseColor.r) * hoverAnimation); c.g = (unsigned char)(baseColor.g + (hoverColor.g - baseColor.g) * hoverAnimation); c.b = (unsigned char)(baseColor.b + (hoverColor.b - baseColor.b) * hoverAnimation); }
        float sc = 1.0f + hoverAnimation * 0.05f;
        Rectangle sb = { bounds.x - (bounds.width * (sc - 1.0f)) / 2.0f, bounds.y - (bounds.height * (sc - 1.0f)) / 2.0f, bounds.width * sc, bounds.height * sc };
        for (int i = 4; i >= 1; i--) { Color gc = c; gc.a = (unsigned char)(30 / i * (1.0f + hoverAnimation)); DrawRectangleRounded({sb.x - i * 4.0f, sb.y - i * 4.0f, sb.width + i * 8.0f, sb.height + i * 8.0f}, 0.15f, 4, gc); }
        DrawRectangleRounded(sb, 0.15f, 4, c); DrawRectangleRoundedLines(sb, 0.15f, 4, WHITE);
        int fs = 28; int tw = MeasureText(text.c_str(), fs);
        DrawText(text.c_str(), (int)(sb.x + sb.width / 2 - tw / 2), (int)(sb.y + sb.height / 2 - fs / 2), fs, textColor);
    }
};

inline unsigned char CC(int v) { return (unsigned char)(v < 0 ? 0 : (v > 255 ? 255 : v)); }

Vector2 RotateVectorCustom(Vector2 v, float angle) {
    Vector2 r;
    r.x = v.x * cosf(angle) - v.y * sinf(angle);
    r.y = v.x * sinf(angle) + v.y * cosf(angle);
    return r;
}
